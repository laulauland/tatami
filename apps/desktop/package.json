{
	"name": "desktop",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun run build:native && concurrently \"vite --config vite.electrobun.config.ts\" \"NODE_ENV=development vite build --mode development --config vite.electrobun.config.ts && ELECTROBUN_DEV_SERVER_URL=http://localhost:${DEV_SERVER_PORT:-5174} electrobun dev\"",
		"build": "bun run build:native && vite build --config vite.electrobun.config.ts && electrobun build --env=canary",
		"build:native": "cargo build -p tatami-jj-native && bun scripts/prepare-native-addon.ts",
		"typecheck": "tsgo --noEmit",
		"lint": "biome check . && ast-grep scan",
		"format": "biome format --write .",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest --passWithNoTests",
		"electrobun:dev": "bun run dev",
		"electrobun:build": "bun run build"
	},
	"dependencies": {
		"@effect-atom/atom": "^0.4.11",
		"@pierre/diffs": "^1.1.19",
		"@pierre/trees": "^1.0.0-beta.3",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/db": "^0.6.5",
		"@tanstack/svelte-db": "^0.1.82",
		"@tanstack/svelte-virtual": "^3.13.24",
		"effect": "^3.19.13"
	},
	"devDependencies": {
		"@ast-grep/cli": "^0.40.5",
		"@biomejs/biome": "^2.3.10",
		"@sveltejs/vite-plugin-svelte": "^5.0.1",
		"@tanstack/devtools-vite": "^0.5.0",
		"@types/node": "^25.0.3",
		"@types/three": "^0.165.0",
		"@typescript/native-preview": "^7.0.0-dev.20251219.1",
		"agentation": "^1.1.0",
		"concurrently": "^9.1.0",
		"electrobun": "latest",
		"element-source": "^0.0.5",
		"react-grab": "^0.1.44",
		"svelte": "^5.14.1",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.6.3",
		"vite": "^7.3.1",
		"vite-plugin-agentation": "file:../../../agentation/vite-plugin/",
		"vitest": "^4.0.18"
	}
}
