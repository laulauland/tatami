  "devDependencies": {
    "@ast-grep/cli": "^0.40.5",
    "@biomejs/biome": "^2.3.10",
    "@tanstack/devtools-vite": "^0.5.0",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^25.0.3",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@typescript/native-preview": "^7.0.0-dev.20251219.1",
    "@vitejs/plugin-react": "^5.1.2",
    "agentation": "^1.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^28.0.0",
    "react-grab": "^0.1.32",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.6.3",
    "vite": "^7.3.1",
    "vite-plugin-agentation": "file:../../../agentation/vite-plugin/",
