{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsgo && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsgo --noEmit",
    "lint": "biome check . && ast-grep scan",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "electrobun:dev": "vite build --config vite.electrobun.config.ts && electrobun dev",
    "electrobun:dev:hmr": "concurrently \"vite --config vite.electrobun.config.ts --port 5174\" \"vite build --config vite.electrobun.config.ts && electrobun dev\"",
    "electrobun:build": "vite build --config vite.electrobun.config.ts && electrobun build --env=canary"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@codemirror/commands": "^6.10.2",
    "@codemirror/language": "^6.12.1",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.14",
    "@effect-atom/atom": "^0.4.11",
    "@effect-atom/atom-react": "^0.4.4",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@pierre/diffs": "^1.1.19",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/db": "^0.6.5",
    "@tanstack/query-core": "^5.100.5",
    "@tanstack/query-db-collection": "^1.0.36",
    "@tanstack/react-db": "^0.1.83",
    "@tanstack/react-query": "^5.100.5",
    "@tanstack/react-router": "^1.141.6",
    "@tanstack/react-virtual": "^3.13.16",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-deep-link": "^2.4.8",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "effect": "^3.19.13",
    "lucide-react": "^0.562.0",
    "react": "19",
    "react-dom": "19",
    "react-resizable-panels": "^4.0.10",
    "scheduler": "^0.27.0",
    "shadcn": "^3.6.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0"
